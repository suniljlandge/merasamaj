# WhatsApp Web Sidecar Service Configuration

# Server
PORT=3001
API_SECRET=change-this-to-a-random-secret

# MongoDB (shared with main SAMAJ app)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=samaj

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=samaj-backups

# Rate Limiting
MAX_DAILY_WEB_SENDS=20
PROFILE_PIC_FETCH_DELAY_MS=2500

# Standalone UI
UI_PASSWORD=admin

# Main SAMAJ Flask app (for TN lookup proxy)
SAMAJ_APP_URL=http://localhost:5000
SAMAJ_APP_SECRET=
SAMAJ_SESSION_COOKIE=
