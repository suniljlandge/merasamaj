# SAMAJ environment configuration example.
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.

# --- MongoDB ---------------------------------------------------------------
# Connection string for the MongoDB instance / Atlas cluster.
MONGO_URI=mongodb://127.0.0.1:27017
# Database name.
MONGO_DB=samaj
# Primary registrations collection.
MONGO_COLLECTION=registrations
# Collection holding learned transliteration corrections.
MONGO_CORRECTIONS_COLLECTION=transliteration_corrections

# --- OTP / login -----------------------------------------------------------
# Set to 1/true to enable OTP test mode (uses a fixed code, no provider call).
OTP_TEST_MODE=0
# Fixed OTP code used when OTP_TEST_MODE is enabled.
OTP_FIXED_CODE=

# --- Meta WhatsApp Cloud API ----------------------------------------------
# Used for OTP delivery and Campaign Manager bulk template messages.
# These are FALLBACKS only: the active values are normally stored in the
# `app_settings` collection (otp_settings.metaWhatsApp) and managed from the
# OTP settings page. The env vars are used when the stored values are blank.
WA_TOKEN=
WA_PHONE_ID=

# --- Razorpay (Campaign Manager payments) ----------------------------------
# Razorpay API key id (public, e.g. rzp_test_XXXX / rzp_live_XXXX).
RAZORPAY_KEY_ID=
# Razorpay API key secret. Keep this private.
RAZORPAY_KEY_SECRET=
# Secret configured for the Razorpay webhook, used to verify the
# X-Razorpay-Signature header on payment.captured events.
RAZORPAY_WEBHOOK_SECRET=

# --- Server ----------------------------------------------------------------
# Port for the local dev server.
PORT=5000
